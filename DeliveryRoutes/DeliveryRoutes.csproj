<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeliveryRoutes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Static files of the localhost front end are copied next to the executable. -->
    <None Update="Web\public\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
